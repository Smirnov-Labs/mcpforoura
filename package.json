{
  "name": "@smirnovlabs/mcpforoura",
  "version": "0.1.1",
  "private": true,
  "description": "Hosted remote MCP server for Oura Ring on Cloudflare Workers with OAuth",
  "author": "Ivan Smirnov <isgsmirnov@gmail.com>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "start": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "cf-typegen": "wrangler types",
    "type-check": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:workers",
    "test:unit": "vitest run --config vitest.config.ts --passWithNoTests",
    "test:workers": "vitest run --config vitest.worker.config.ts --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@modelcontextprotocol/server": "2.3.1",
    "agents": "^0.31.0",
    "hono": "^4.13.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.9",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.154.0"
  }
}
